<%- include('partials/header.ejs') %>

<main class="main-content">
    <section class="contact-page">
        <div class="contact-hero">
            <span class="contact-kicker">Contacto</span>
            <h1>Hablemos de tu próximo proyecto</h1>
            <p>
                Si necesitas ayuda con un proyecto web, quieres colaborar o simplemente me quieres contar una idea,
                estaré encantado de responderte y conversar contigo.
            </p>
        </div>

        <div class="contact-grid">
            <div class="contact-card contact-info">
                <h2>Información</h2>
                <ul>
                    <li>
                        <i class="fa-solid fa-envelope"></i>
                        <a href="mailto:gerardo.vaz.galindo@gmail.com">gerardo.vaz.galindo@gmail.com</a>
                    </li>
                    <li>
                        <i class="fa-solid fa-phone"></i>
                        <span>+52 449 142 7022</span>
                    </li>
                    <li>
                        <i class="fa-solid fa-location-dot"></i>
                        <span>Aguascalientes, México</span>
                    </li>
                </ul>

                <div class="social-links">
                    <a href="https://github.com/GerardoVazGa" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                        <i class="fa-brands fa-github"></i>
                    </a>
                    <a href="https://www.linkedin.com/in/gerardo-vazquez-galindo-099765305" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <i class="fa-brands fa-linkedin-in"></i>
                    </a>
                </div>
            </div>

            <div class="contact-card contact-form-wrapper">
                <h2>Envíame un mensaje</h2>
                <form class="contact-form" action="mailto:gerardo.vaz.galindo@gmail.com" method="post" enctype="text/plain">
                    <div class="form-group">
                        <label for="name">Nombre</label>
                        <input id="name" name="name" type="text" class="form-input" placeholder="Tu nombre" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Correo electrónico</label>
                        <input id="email" name="email" type="email" class="form-input" placeholder="tu@email.com" required>
                    </div>

                    <div class="form-group">
                        <label for="subject">Asunto</label>
                        <input id="subject" name="subject" type="text" class="form-input" placeholder="¿De qué quieres hablar?" required>
                    </div>

                    <div class="form-group">
                        <label for="message">Mensaje</label>
                        <textarea id="message" name="message" class="form-textarea" rows="5" placeholder="Cuéntame un poco más sobre tu idea o proyecto..." required></textarea>
                    </div>

                    <button type="submit" class="btn-submit">Enviar mensaje</button>
                </form>
            </div>
        </div>
    </section>
</main>

<%- include('partials/scripts.ejs') %>

<%- include('partials/footer.ejs') %>
